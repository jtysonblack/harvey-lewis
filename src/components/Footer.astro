      <nav class="footer__nav">
        <div class="footer__nav-col">
          <p class="footer__nav-heading">Navigate</p>
          <a href="/about">About</a>
          <a href="/media">Media</a>
          <a href="/youtube">Videos</a>
          <a href="/sponsors">Sponsors</a>
          <a href="/speaking">Speaking</a>
