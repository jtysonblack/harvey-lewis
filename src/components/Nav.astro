---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/media', label: 'Media' },
  { href: '/youtube', label: 'Videos' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/speaking', label: 'Speaking' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo">
      <span class="nav__logo-name">Harvey Lewis</span>
      <span class="nav__logo-title">Ultra</span>
    </a>

    <nav class="nav__links" id="nav-links">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav__link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'nav__link--active' : ''}`}
        >
          {link.label}
        </a>
      ))}
      <a href="/speaking" class="btn btn--primary nav__cta">Book Harvey</a>
    </nav>

    <button class="nav__hamburger" id="nav-toggle" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-height);
    background: rgba(12, 12, 12, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav__logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    gap: 1px;
  }

  .nav__logo-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .nav__logo-title {
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0.5rem 0.875rem;
    transition: color 0.2s ease;
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--color-text);
  }

  .nav__cta {
    margin-left: 1rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.75rem;
  }

  .nav__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav__hamburger span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--color-text);
    transition: all 0.3s ease;
  }

  @media (max-width: 900px) {
    .nav__hamburger {
      display: flex;
    }

    .nav__links {
      display: none;
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-bg);
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem 1.5rem;
      gap: 0;
      border-top: 1px solid var(--color-border);
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__link {
      font-size: 1rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-border);
      width: 100%;
    }

    .nav__cta {
      margin-left: 0;
      margin-top: 1.5rem;
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    links?.classList.toggle('is-open');
  });
</script>
