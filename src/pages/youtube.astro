---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const videos = [
  {
    category: 'Harvey\'s Channel',
    items: [
      { id: 'S3LT2XfyBdo', title: 'How This 47-Year-Old Teacher Ran For 4 DAYS Straight', channel: 'Rich Roll Podcast' },
      { id: 'YjlgImSlKH0', title: 'Breaking the Record at Big\'s Backyard Ultra with Harvey Lewis', channel: 'REI Uncommon Path' },
      { id: 'E7yw1LkEhzU', title: 'Inside the Mind Of 450 Mile Backyard Ultra Record Holder', channel: 'Backyard Ultra Podcast' },
    ],
  },
  {
    category: 'Race Coverage & Interviews',
    items: [
      { id: 'YjlgImSlKH0', title: 'Breaking the Record at Big\'s Backyard Ultra', channel: 'REI' },
      { id: 'E7yw1LkEhzU', title: 'Inside the Mind of the World Record Holder', channel: 'Backyard Ultra Podcast' },
    ],
  },
];
---

<Layout
  title="Videos"
  description="Watch Harvey Lewis — race footage, interviews, and videos from the two-time Big's Backyard Ultra champion."
>
  <Nav />

  <main>
    <div class="page-hero">
      <div class="container">
        <p class="eyebrow page-hero__eyebrow">Watch</p>
        <h1 class="page-hero__title">Videos</h1>
        <p class="page-hero__subtitle">
          Race footage, interviews, and Harvey's own YouTube channel —
          <em>Living Ultra with Harvey and Kelly</em>.
        </p>
      </div>
    </div>

    <!-- Channel link -->
    <section class="section--sm channel-banner">
      <div class="container">
        <div class="channel-banner__inner">
          <div class="channel-banner__icon">
            <svg width="32" height="32" fill="var(--color-accent)" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <div>
            <p class="channel-banner__name display">Living Ultra with Harvey and Kelly</p>
            <p class="channel-banner__desc">Harvey's personal YouTube channel — training, race prep, life on the trail.</p>
          </div>
          <a
            href="https://youtube.com/@HarveyandKelly"
            target="_blank"
            rel="noopener"
            class="btn btn--primary"
          >
            Subscribe →
          </a>
        </div>
      </div>
    </section>

    <!-- Videos -->
    <section class="section">
      <div class="container">
        <p class="eyebrow">Featured</p>
        <div class="divider"></div>
        <h2 class="section-title display">Must Watch</h2>

        <!-- Featured large -->
        <div class="featured-video">
          <div class="video-embed__wrapper">
            <iframe
              src="https://www.youtube.com/embed/S3LT2XfyBdo"
              title="How This 47-Year-Old Teacher Ran For 4 DAYS Straight — Harvey Lewis x Rich Roll"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="featured-video__info">
            <span class="eyebrow">Rich Roll Podcast</span>
            <h3 class="featured-video__title serif">How This 47-Year-Old Teacher Ran For 4 DAYS Straight</h3>
            <p class="featured-video__desc">
              Harvey sits down with Rich Roll to break down the physical and mental reality of running
              for four and a half days. His training, his plant-based fuel strategy, and what it actually
              feels like when the world falls away and you enter that other mode.
            </p>
          </div>
        </div>

        <!-- Grid of others -->
        <div class="video-grid">
          <div class="video-embed">
            <div class="video-embed__wrapper">
              <iframe
                src="https://www.youtube.com/embed/YjlgImSlKH0"
                title="Breaking the Record at Big's Backyard Ultra with Harvey Lewis"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <span class="eyebrow video-label">REI Uncommon Path</span>
            <p class="video-title">Breaking the Record at Big's Backyard Ultra</p>
          </div>

          <div class="video-embed">
            <div class="video-embed__wrapper">
              <iframe
                src="https://www.youtube.com/embed/E7yw1LkEhzU"
                title="Inside the Mind Of 450 Mile Backyard Ultra Record Holder Harvey Lewis"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <span class="eyebrow video-label">Backyard Ultra Podcast</span>
            <p class="video-title">Inside the Mind of the 450-Mile Record Holder</p>
          </div>
        </div>

        <div style="text-align: center; margin-top: 3rem;">
          <a
            href="https://youtube.com/@HarveyandKelly"
            target="_blank"
            rel="noopener"
            class="btn btn--outline"
          >
            More on Harvey's Channel →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .channel-banner {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .channel-banner__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    flex-wrap: wrap;
  }

  .channel-banner__icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    background: var(--color-bg-3);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .channel-banner__name {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .channel-banner__desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .channel-banner a.btn {
    margin-left: auto;
  }

  .section-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 2.5rem;
  }

  /* Featured large video */
  .featured-video {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .video-embed__wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .video-embed__wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .featured-video__info {
    padding-top: 0.5rem;
  }

  .featured-video__title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin: 1rem 0;
    line-height: 1.3;
  }

  .featured-video__desc {
    color: var(--color-text-muted);
    line-height: 1.75;
    font-size: 0.9375rem;
  }

  /* Grid */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .video-label {
    display: block;
    margin: 1rem 0 0.375rem;
  }

  .video-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .featured-video {
      grid-template-columns: 1fr;
    }

    .channel-banner a.btn {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
